<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Sample KML for Testing</name>
    <Placemark>
      <name>Test Polygon</name>
      <description>A simple square polygon</description>
      <Polygon>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              -122.084,37.422,0
              -122.086,37.422,0
              -122.086,37.420,0
              -122.084,37.420,0
              -122.084,37.422,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>Test Line</name>
      <description>A simple line</description>
      <LineString>
        <coordinates>
          -122.084,37.422,0
          -122.086,37.420,0
        </coordinates>
      </LineString>
    </Placemark>
  </Document>
</kml>
